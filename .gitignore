# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/sandbox/node_modules
/services/**/node_modules
/.pnp
.pnp.*
.bun

# testing
/coverage

# next.js
/.next/
/out/

# react-router
/.react-router/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
bun-debug.log*
bun-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
/.open-next

# terraform
infra/*.tfvars
infra/.terraform/
infra/*.tfstate*

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Playwright
test-results/
playwright-report/

# Swap files
*.swp
*.swo
sandbox/bun.lock

# Downloaded container session files
*.jsonl

# Local sandbox-host persistence and state
.sandbox-host/
services/sandbox-host/.sandbox-host/

# Integration test temp files
tests/integration/.server-url
sandbox/.r2-creds
package-lock.json

# Pre-built renderer bundle (built at CI time)
sandbox/create-worker/renderer-dist/

# Auto-generated embedded files
workers/main/src/embedded-create-worker.ts
workers/main/src/embedded-skills.ts
