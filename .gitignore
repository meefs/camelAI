# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/sandbox/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# react-router
/.react-router/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
/.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Playwright
test-results/
playwright-report/

# Swap files
*.swp
*.swo
sandbox/bun.lock

# Downloaded container session files
*.jsonl

# Integration test temp files
tests/integration/.server-url
sandbox/.r2-creds
packages/chiridion-wrangler/node_modules
packages/chiridion-wrangler/dist
