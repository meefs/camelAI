{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-outbound",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	// Service binding to Chiridion's RPC service for getting integration credentials
	"services": [
		{
			"binding": "CHIRIDION",
			"service": "chiridion-app",
			"entrypoint": "DoRpcService"
		}
	],
	"env": {
		"staging": {
			"name": "chiridion-outbound-staging",
			"services": [
				{
					"binding": "CHIRIDION",
					"service": "chiridion-app-staging",
					"entrypoint": "DoRpcService"
				}
			]
		}
	}
}
