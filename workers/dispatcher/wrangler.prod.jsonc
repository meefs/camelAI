{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher",
	"main": "src/index.ts",
	"alias": {
		"virtual:db-query-runner-source": "./src/db-query-runner-source.ts"
	},
	"rules": [
		{ "type": "Text", "globs": ["**/db-query-runner.mjs"], "fallthrough": true }
	],
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
		"MAIN_APP_URL": "https://camelai.dev",
		// Temporary migration mode. "legacy-open" fails closed except for legacy hostnames.
		"DISPATCHER_MISSING_REGISTRY_MODE": "legacy-open"
	},
	"routes": [
		// Cloudflare for SaaS custom hostnames enter the zone under the customer
		// hostname, so a zone-wide route is required for grey-cloud CNAMEs.
		{ "pattern": "*/*", "zone_name": "camelai.app" },
		// Matches both legacy (script.apps) and new (script.org-slug.apps)
		{ "pattern": "*.apps.camelai.dev/*", "zone_name": "camelai.dev" },
		{ "pattern": "*.camelai.app/*", "zone_name": "camelai.app" },
		// Fallback origin for Cloudflare for SaaS custom hostnames
		{ "pattern": "custom-domains.camelai.app", "custom_domain": true }
	],
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform"
		}
	],
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "0ee80299e67c4c7fa0c1ad618b7e7a9c" },
		{ "binding": "SESSIONS", "id": "67958a5b0d104621bd93c91c802ccd1c" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app" }
		]
	}
}
