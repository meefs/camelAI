{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher-staging",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		// New format: script.org-slug.apps.staging.chiridion.ai
		{ "pattern": "*.*.apps.staging.chiridion.ai/*", "zone_name": "chiridion.ai" },
		// Legacy format: script.apps.staging.chiridion.ai
		{ "pattern": "*.apps.staging.chiridion.ai/*", "zone_name": "chiridion.ai" },
		// New format: script.org-slug.staging.chiridion.app
		{ "pattern": "*.*.staging.chiridion.app/*", "zone_name": "chiridion.app" },
		// Legacy format: script.staging.chiridion.app
		{ "pattern": "*.staging.chiridion.app/*", "zone_name": "chiridion.app" }
	],
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform-staging"
		}
	],
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "e894eb2caf1641ad8870da994b992fce" },
		{ "binding": "SESSIONS", "id": "f5ab08fdb1d7404fbc45a171217b4a27" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-staging" }
		]
	}
}
