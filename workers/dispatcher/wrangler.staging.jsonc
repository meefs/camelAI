{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher-staging",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
		"MAIN_APP_URL": "https://staging.camelai.dev",
		// Temporary migration mode. "legacy-open" fails closed except for legacy hostnames.
		"DISPATCHER_MISSING_REGISTRY_MODE": "legacy-open"
	},
	"routes": [
		// Matches both legacy (script.apps.staging) and new (script.org-slug.apps.staging)
		{ "pattern": "*.apps.staging.camelai.dev/*", "zone_name": "camelai.dev" },
		{ "pattern": "*.staging.camelai.app/*", "zone_name": "camelai.app" },
		// Fallback origin for Cloudflare for SaaS custom hostnames
		{ "pattern": "custom-domains.staging.camelai.app", "custom_domain": true }
	],
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform-staging"
		}
	],
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "e894eb2caf1641ad8870da994b992fce" },
		{ "binding": "SESSIONS", "id": "f5ab08fdb1d7404fbc45a171217b4a27" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-staging" }
		]
	}
}
