{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher-dev-miguel",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		// Temporary migration mode. "legacy-open" fails closed except for legacy hostnames.
		"DISPATCHER_MISSING_REGISTRY_MODE": "legacy-open"
	},
	"routes": [
		// Matches both legacy and new format
		{ "pattern": "*.apps.dev-miguel.chiridion.ai/*", "zone_name": "chiridion.ai" },
		{ "pattern": "*.dev-miguel.chiridion.app/*", "zone_name": "chiridion.app" }
	],
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform-dev-miguel"
		}
	],
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "e894eb2caf1641ad8870da994b992fce" },
		{ "binding": "SESSIONS", "id": "a38773869d2e465fbf705c81fa2e01eb" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-dev-miguel" }
		]
	}
}
