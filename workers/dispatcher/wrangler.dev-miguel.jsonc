{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher-dev-miguel",
	"main": "src/index.ts",
	"alias": {
		"virtual:db-query-runner-source": "./src/db-query-runner-source.ts"
	},
	"rules": [
		{ "type": "Text", "globs": ["**/db-query-runner.mjs"], "fallthrough": true }
	],
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
		"MAIN_APP_URL": "https://dev-miguel.camelai.dev"
	},
	"routes": [
		// Canonical org-scoped app hostnames
		{ "pattern": "*.apps.dev-miguel.camelai.dev/*", "zone_name": "camelai.dev" },
		{ "pattern": "*.dev-miguel.camelai.app/*", "zone_name": "camelai.app" }
	],
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform-dev-miguel"
		}
	],
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "e894eb2caf1641ad8870da994b992fce" },
		{ "binding": "SESSIONS", "id": "a38773869d2e465fbf705c81fa2e01eb" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-dev-miguel" }
		]
	}
}
