{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher-evals",
	"main": "src/index.ts",
	"alias": {
		"virtual:db-query-runner-source": "./src/db-query-runner-source.ts"
	},
	"rules": [
		{ "type": "Text", "globs": ["**/db-query-runner.mjs"], "fallthrough": true }
	],
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
		"MAIN_APP_URL": "https://staging.camelai.dev",
		// Testing-grounds apps are deployed from in-process evals whose deploy side effects
		// (the APP_KV `script:` access entries) land in the eval worker's local KV, not this
		// dispatcher's KV. "open" serves any script present in the dispatch namespace as public
		// so eval apps are usable without a real registry entry.
		"DISPATCHER_MISSING_REGISTRY_MODE": "open"
	},
	"routes": [
		{ "pattern": "*.apps.evals.camelai.dev/*", "zone_name": "camelai.dev" },
		{ "pattern": "*.evals.camelai.app/*", "zone_name": "camelai.app" }
	],
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform-evals"
		}
	],
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "e894eb2caf1641ad8870da994b992fce" },
		{ "binding": "SESSIONS", "id": "f5ab08fdb1d7404fbc45a171217b4a27" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-staging" }
		]
	}
}
