{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform",
			"outbound": {
				"service": "chiridion-outbound",
				"parameters": ["params"]
			}
		}
	],
	// KV namespace for script->org mapping (same as main app's EMAIL_TO_USER)
	"kv_namespaces": [
		{
			"binding": "SCRIPT_MAPPINGS",
			"id": "45b452b3b19c42f6991408c140149a70"
		}
	],
	// Subdomain routing for chiridion.ai
	"routes": [
		{
			"pattern": "*.chiridion.ai/*",
			"zone_name": "chiridion.ai"
		}
	],
	"env": {
		"staging": {
			"name": "chiridion-dispatcher-staging",
			"kv_namespaces": [
				{
					"binding": "SCRIPT_MAPPINGS",
					"id": "ab267c4f44b847dda8bdca400a4e1884"
				}
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform",
					"outbound": {
						"service": "chiridion-outbound-staging",
						"parameters": ["params"]
					}
				}
			]
		}
	}
}
