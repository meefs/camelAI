{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	// Dev defaults (inherited by all envs)
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform",
			"outbound": {
				"service": "chiridion-outbound",
				"parameters": ["params"]
			}
		}
	],
	// Shared dev/staging KV namespace
	"kv_namespaces": [
		{
			"binding": "SCRIPT_MAPPINGS",
			"id": "ab267c4f44b847dda8bdca400a4e1884"
		}
	],
	"env": {
		"prod": {
			"name": "chiridion-dispatcher",
			"routes": [
				{ "pattern": "*.chiridion.ai/*", "zone_name": "chiridion.ai" }
			],
			// Prod KV namespace
			"kv_namespaces": [
				{
					"binding": "SCRIPT_MAPPINGS",
					"id": "45b452b3b19c42f6991408c140149a70"
				}
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform",
					"outbound": {
						"service": "chiridion-outbound",
						"parameters": ["params"]
					}
				}
			]
		},
		"staging": {
			"name": "chiridion-dispatcher-staging",
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform",
					"outbound": {
						"service": "chiridion-outbound-staging",
						"parameters": ["params"]
					}
				}
			]
		},
		"dev-miguel": {
			"name": "chiridion-dispatcher-dev-miguel",
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform",
					"outbound": {
						"service": "chiridion-outbound-dev-miguel",
						"parameters": ["params"]
					}
				}
			]
		},
		"dev-illiana": {
			"name": "chiridion-dispatcher-dev-illiana",
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform",
					"outbound": {
						"service": "chiridion-outbound-dev-illiana",
						"parameters": ["params"]
					}
				}
			]
		}
	}
}
