{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	// Dev defaults (inherited by all envs)
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform"
		}
	],
	"env": {
		"prod": {
			"name": "chiridion-dispatcher",
			"routes": [
				{ "pattern": "*.chiridion.ai/*", "zone_name": "chiridion.ai" }
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform"
				}
			]
		},
		"staging": {
			"name": "chiridion-dispatcher-staging",
			"routes": [
				{ "pattern": "*.staging.chiridion.ai/*", "zone_name": "chiridion.ai" }
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform"
				}
			]
		},
		"dev-miguel": {
			"name": "chiridion-dispatcher-dev-miguel",
			"routes": [
				{ "pattern": "*.dev-miguel.chiridion.ai/*", "zone_name": "chiridion.ai" }
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform"
				}
			]
		},
		"dev-illiana": {
			"name": "chiridion-dispatcher-dev-illiana",
			"routes": [
				{ "pattern": "*.dev-illiana.chiridion.ai/*", "zone_name": "chiridion.ai" }
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform"
				}
			]
		}
	}
}
