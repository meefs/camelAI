{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-dispatcher",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	// Local dev defaults - skip auth and use local namespace
	"vars": {
		"SKIP_AUTH": "true"
	},
	"dispatch_namespaces": [
		{
			"binding": "DISPATCHER",
			"namespace": "chiridion-platform-local"
		}
	],
	"kv_namespaces": [
		{
			"binding": "APP_KV",
			"id": "e894eb2caf1641ad8870da994b992fce"
		},
		{
			"binding": "SESSIONS",
			"id": "f5ab08fdb1d7404fbc45a171217b4a27"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app" }
		]
	},
	"env": {
		"prod": {
			"name": "chiridion-dispatcher",
			"routes": [
				// New format: script.org-slug.apps.chiridion.ai
				{ "pattern": "*.*.apps.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// Legacy format: script.apps.chiridion.ai
				{ "pattern": "*.apps.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// New format: script.org-slug.chiridion.app
				{ "pattern": "*.*.chiridion.app/*", "zone_name": "chiridion.app" },
				// Legacy format: script.chiridion.app
				{ "pattern": "*.chiridion.app/*", "zone_name": "chiridion.app" }
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform"
				}
			],
			"kv_namespaces": [
				{
					"binding": "APP_KV",
					"id": "0ee80299e67c4c7fa0c1ad618b7e7a9c"
				},
				{
					"binding": "SESSIONS",
					"id": "67958a5b0d104621bd93c91c802ccd1c"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app" }
				]
			}
		},
		"staging": {
			"name": "chiridion-dispatcher-staging",
			"routes": [
				// New format: script.org-slug.apps.staging.chiridion.ai
				{ "pattern": "*.*.apps.staging.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// Legacy format: script.apps.staging.chiridion.ai
				{ "pattern": "*.apps.staging.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// New format: script.org-slug.staging.chiridion.app
				{ "pattern": "*.*.staging.chiridion.app/*", "zone_name": "chiridion.app" },
				// Legacy format: script.staging.chiridion.app
				{ "pattern": "*.staging.chiridion.app/*", "zone_name": "chiridion.app" }
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform-staging"
				}
			],
			"kv_namespaces": [
				{
					"binding": "APP_KV",
					"id": "e894eb2caf1641ad8870da994b992fce"
				},
				{
					"binding": "SESSIONS",
					"id": "f5ab08fdb1d7404fbc45a171217b4a27"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-staging" }
				]
			}
		},
		"dev-miguel": {
			"name": "chiridion-dispatcher-dev-miguel",
			"routes": [
				// New format: script.org-slug.apps.dev-miguel.chiridion.ai
				{ "pattern": "*.*.apps.dev-miguel.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// Legacy format: script.apps.dev-miguel.chiridion.ai
				{ "pattern": "*.apps.dev-miguel.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// New format: script.org-slug.dev-miguel.chiridion.app
				{ "pattern": "*.*.dev-miguel.chiridion.app/*", "zone_name": "chiridion.app" },
				// Legacy format: script.dev-miguel.chiridion.app
				{ "pattern": "*.dev-miguel.chiridion.app/*", "zone_name": "chiridion.app" }
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform-dev-miguel"
				}
			],
			"kv_namespaces": [
				{
					"binding": "APP_KV",
					"id": "e894eb2caf1641ad8870da994b992fce"
				},
				{
					"binding": "SESSIONS",
					"id": "a38773869d2e465fbf705c81fa2e01eb"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-dev-miguel" }
				]
			}
		},
		"dev-illiana": {
			"name": "chiridion-dispatcher-dev-illiana",
			"routes": [
				// New format: script.org-slug.apps.dev-illiana.chiridion.ai
				{ "pattern": "*.*.apps.dev-illiana.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// Legacy format: script.apps.dev-illiana.chiridion.ai
				{ "pattern": "*.apps.dev-illiana.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// New format: script.org-slug.dev-illiana.chiridion.app
				{ "pattern": "*.*.dev-illiana.chiridion.app/*", "zone_name": "chiridion.app" },
				// Legacy format: script.dev-illiana.chiridion.app
				{ "pattern": "*.dev-illiana.chiridion.app/*", "zone_name": "chiridion.app" }
			],
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform-dev-illiana"
				}
			],
			"kv_namespaces": [
				{
					"binding": "APP_KV",
					"id": "e894eb2caf1641ad8870da994b992fce"
				},
				{
					"binding": "SESSIONS",
					"id": "c632a963433e4949b6dea43728034b36"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-dev-illiana" }
				]
			}
		},
		"local": {
			"name": "chiridion-dispatcher-local",
			"routes": [
				// New format: script.org-slug.apps.local.chiridion.ai
				{ "pattern": "*.*.apps.local.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// Legacy format: script.apps.local.chiridion.ai
				{ "pattern": "*.apps.local.chiridion.ai/*", "zone_name": "chiridion.ai" },
				// New format: script.org-slug.local.chiridion.app
				{ "pattern": "*.*.local.chiridion.app/*", "zone_name": "chiridion.app" },
				// Legacy format: script.local.chiridion.app
				{ "pattern": "*.local.chiridion.app/*", "zone_name": "chiridion.app" }
			],
			"vars": {
				"SKIP_AUTH": "true"
			},
			"dispatch_namespaces": [
				{
					"binding": "DISPATCHER",
					"namespace": "chiridion-platform-local"
				}
			],
			"kv_namespaces": [
				{
					"binding": "APP_KV",
					"id": "e894eb2caf1641ad8870da994b992fce"
				},
				{
					"binding": "SESSIONS",
					"id": "f5ab08fdb1d7404fbc45a171217b4a27"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app" }
				]
			}
		}
	}
}
