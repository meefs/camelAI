{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-llm-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"PROXY_FALLBACK_ORDER": "bedrock-api-key,foundry,anthropic",
		"ANTHROPIC_VERSION": "2023-06-01"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app" }
		]
	},
	"routes": [
		{ "pattern": "llm-proxy.chiridion.ai/*", "zone_name": "chiridion.ai" }
	]
}
