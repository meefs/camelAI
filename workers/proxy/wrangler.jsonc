{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-llm-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"],

	"vars": {
		"PROXY_FALLBACK_ORDER": "bedrock-api-key,foundry,anthropic",
		"ANTHROPIC_VERSION": "2023-06-01"
		// "PROXY_PROVIDERS": "[{\"name\":\"anthropic\",\"type\":\"anthropic\"},{\"name\":\"foundry\",\"type\":\"foundry\"},{\"name\":\"bedrock\",\"type\":\"bedrock\",\"modelId\":\"anthropic.claude-3-5-sonnet-20241022-v2:0\"}]"
	},

	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app" }
		]
	},

	"env": {
		"prod": {
			"name": "chiridion-llm-proxy",
			"vars": {
				"PROXY_FALLBACK_ORDER": "bedrock-api-key,foundry,anthropic",
				"ANTHROPIC_VERSION": "2023-06-01"
			},
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app" }
				]
			},
			"routes": [
				{ "pattern": "llm-proxy.chiridion.ai/*", "zone_name": "chiridion.ai" }
			]
		},
		"staging": {
			"name": "chiridion-llm-proxy-staging",
			"vars": {
				"PROXY_FALLBACK_ORDER": "bedrock-api-key,foundry,anthropic",
				"ANTHROPIC_VERSION": "2023-06-01"
			},
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-staging" }
				]
			},
			"routes": [
				{ "pattern": "llm-proxy.staging.chiridion.ai/*", "zone_name": "chiridion.ai" }
			]
		},
		"dev-miguel": {
			"name": "chiridion-llm-proxy-dev-miguel",
			"vars": {
				"PROXY_FALLBACK_ORDER": "bedrock-api-key,foundry,anthropic",
				"ANTHROPIC_VERSION": "2023-06-01"
			},
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-dev-miguel" }
				]
			},
			"routes": [
				{ "pattern": "llm-proxy.dev-miguel.chiridion.ai/*", "zone_name": "chiridion.ai" }
			]
		},
		"dev-illiana": {
			"name": "chiridion-llm-proxy-dev-illiana",
			"vars": {
				"PROXY_FALLBACK_ORDER": "bedrock-api-key,foundry,anthropic",
				"ANTHROPIC_VERSION": "2023-06-01"
			},
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-dev-illiana" }
				]
			},
			"routes": [
				{ "pattern": "llm-proxy.dev-illiana.chiridion.ai/*", "zone_name": "chiridion.ai" }
			]
		}
	}
}
