{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "chiridion-admin-cli",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"],

	// This worker is for local use only - never deploy it
	// Run with: npm run admin:staging (or admin:prod, admin:dev-illiana, etc.)

	// Default: query staging environment
	"vars": {
		"TARGET_HOST": "https://staging.chiridion.ai"
	},
	"kv_namespaces": [
		{
			"binding": "EMAIL_TO_USER",
			"id": "ab267c4f44b847dda8bdca400a4e1884",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "chiridion-sandbox",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-staging", "remote": true },
			{ "name": "USER", "class_name": "UserDO", "script_name": "chiridion-app-staging", "remote": true },
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO", "script_name": "chiridion-app-staging", "remote": true },
			{ "name": "SANDBOX", "class_name": "ThreadSandbox", "script_name": "chiridion-app-staging", "remote": true }
		]
	},

	"env": {
		// Query production environment
		"prod": {
			"vars": {
				"TARGET_HOST": "https://chiridion.ai"
			},
			"kv_namespaces": [
				{
					"binding": "EMAIL_TO_USER",
					"id": "45b452b3b19c42f6991408c140149a70",
					"remote": true
				}
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "chiridion-sandbox",
					"remote": true
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app", "remote": true },
					{ "name": "USER", "class_name": "UserDO", "script_name": "chiridion-app", "remote": true },
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO", "script_name": "chiridion-app", "remote": true },
					{ "name": "SANDBOX", "class_name": "ThreadSandbox", "script_name": "chiridion-app", "remote": true }
				]
			}
		},

		// Query dev-illiana environment
		"dev-illiana": {
			"vars": {
				"TARGET_HOST": "https://dev-illiana.chiridion.ai"
			},
			"kv_namespaces": [
				{
					"binding": "EMAIL_TO_USER",
					"id": "ab267c4f44b847dda8bdca400a4e1884",
					"remote": true
				}
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "chiridion-sandbox",
					"remote": true
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-dev-illiana", "remote": true },
					{ "name": "USER", "class_name": "UserDO", "script_name": "chiridion-app-dev-illiana", "remote": true },
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO", "script_name": "chiridion-app-dev-illiana", "remote": true },
					{ "name": "SANDBOX", "class_name": "ThreadSandbox", "script_name": "chiridion-app-dev-illiana", "remote": true }
				]
			}
		},

		// Query dev-miguel environment
		"dev-miguel": {
			"vars": {
				"TARGET_HOST": "https://dev-miguel.chiridion.ai"
			},
			"kv_namespaces": [
				{
					"binding": "EMAIL_TO_USER",
					"id": "ab267c4f44b847dda8bdca400a4e1884",
					"remote": true
				}
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "chiridion-sandbox",
					"remote": true
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "ORG", "class_name": "OrgDO", "script_name": "chiridion-app-dev-miguel", "remote": true },
					{ "name": "USER", "class_name": "UserDO", "script_name": "chiridion-app-dev-miguel", "remote": true },
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO", "script_name": "chiridion-app-dev-miguel", "remote": true },
					{ "name": "SANDBOX", "class_name": "ThreadSandbox", "script_name": "chiridion-app-dev-miguel", "remote": true }
				]
			}
		}
	}
}
