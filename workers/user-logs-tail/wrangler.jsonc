{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiridion-user-logs-tail",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_VIRTUAL_MODEL": "dynamic/auto"
  },
  // Local dev defaults - binds to local chiridion-app
  "durable_objects": {
    "bindings": [
      { "name": "WORKER_LOGS", "class_name": "EphemeralWorkerLogsDO", "script_name": "chiridion-app" }
    ]
  },
  "env": {
    "prod": {
      "name": "chiridion-user-logs-tail",
      "durable_objects": {
        "bindings": [
          { "name": "WORKER_LOGS", "class_name": "EphemeralWorkerLogsDO", "script_name": "chiridion-app" }
        ]
      }
    },
    "staging": {
      "name": "chiridion-user-logs-tail-staging",
      "durable_objects": {
        "bindings": [
          { "name": "WORKER_LOGS", "class_name": "EphemeralWorkerLogsDO", "script_name": "chiridion-app-staging" }
        ]
      }
    },
    "dev-miguel": {
      "name": "chiridion-user-logs-tail-dev-miguel",
      "durable_objects": {
        "bindings": [
          { "name": "WORKER_LOGS", "class_name": "EphemeralWorkerLogsDO", "script_name": "chiridion-app-dev-miguel" }
        ]
      }
    },
    "dev-illiana": {
      "name": "chiridion-user-logs-tail-dev-illiana",
      "durable_objects": {
        "bindings": [
          { "name": "WORKER_LOGS", "class_name": "EphemeralWorkerLogsDO", "script_name": "chiridion-app-dev-illiana" }
        ]
      }
    }
  }
}
