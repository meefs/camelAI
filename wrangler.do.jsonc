{
	"$schema": "node_modules/wrangler/config-schema.json",
	// External DO worker - hosts all Durable Objects for dev
	// Run with: npm run dev:do
	"name": "chiridion-do",
	"main": "worker/index-do.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"R2_BUCKET_NAME": "chiridion-sandbox",
		"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
		"R2_MOUNT_DIR": "/home/claude",
		"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95"
	},
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "chiridion-sandbox"
		}
	],
	"kv_namespaces": [
		{
			"binding": "EMAIL_TO_USER",
			"id": "45b452b3b19c42f6991408c140149a70"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
			{ "name": "CHAT_INDEX", "class_name": "ChatIndexDO" },
			{ "name": "SANDBOX", "class_name": "ThreadSandbox" },
			{ "name": "SESSION", "class_name": "SessionDO" },
			{ "name": "USER", "class_name": "UserDO" },
			{ "name": "ORG", "class_name": "OrgDO" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ChatDurableObject"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["ChatDurableObject"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["ChatThreadDO", "ChatIndexDO"]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": ["ThreadSandbox"]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": ["SessionDO", "UserDO", "OrgDO"]
		}
	]
}
