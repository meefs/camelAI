{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-app-dev-illiana",
	"main": "build/server/index.js",
	"no_bundle": true,
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"tail_consumers": [{ "service": "chiridion-user-logs-tail-dev-illiana" }],
	"rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
	"routes": [
		{ "pattern": "dev-illiana.camelai.dev/*", "zone_name": "camelai.dev" }
	],
	"vpc_services": [
		{
			"binding": "SANDBOX_HOST",
			"service_id": "019c54ff-d555-7741-8464-3b68f8a18edf"
		}
	],
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
			"R2_BUCKET_NAME": "chiridion-sandbox",
			"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
			"R2_MOUNT_DIR": "/home/claude",
			"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
			"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
			"CF_GATEWAY_NAME": "chiridion",
			"CF_DISPATCH_NAMESPACE": "chiridion-platform-dev-illiana",
			"PROJECT_RUNTIME_DOCKER_PROXY_BASE_URL": "http://host.docker.internal:8089",
			"WORKER_BASE_URL": "https://dev-illiana.camelai.dev",
				"EMAIL_FROM_ADDRESS": "no-reply@mail.camelai.com",
				"WORKSPACE_EMAIL_DOMAIN": "camelai.dev",
	
				"EXT_API_CLIENT_ID": "set-me",
				"CF_WORKER_NAME": "chiridion-app-dev-illiana",
			"TAIL_WORKER_NAME": "chiridion-user-logs-tail-dev-illiana",
			"SANDBOX_TRANSPORT": "rpc"
		},
	"assets": {
		"binding": "ASSETS",
		"directory": "build/client"
	},
	"images": { "binding": "IMAGES" },
	"browser": { "binding": "BROWSER" },
	"ai": { "binding": "AI", "remote": true },
	"worker_loaders": [{ "binding": "CODE_MODE_LOADER" }],
	"artifacts": [
		{ "binding": "ARTIFACTS", "namespace": "dev-illiana" }
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"r2_buckets": [
		{ "binding": "R2_BUCKET", "bucket_name": "chiridion-sandbox" }
	],
	"analytics_engine_datasets": [
		{ "binding": "ERROR_ANALYTICS", "dataset": "chiridion_errors_dev_illiana" },
		{ "binding": "OBSERVABILITY_EVENTS", "dataset": "chiridion_observability_dev_illiana" }
	],
	"kv_namespaces": [
		{ "binding": "EMAIL_TO_USER", "id": "b5d67155aac54d208f00fc5d51f2d080" },
		{ "binding": "APP_KV", "id": "e894eb2caf1641ad8870da994b992fce" },
		{ "binding": "SESSIONS", "id": "c632a963433e4949b6dea43728034b36" }
	],
	"d1_databases": [
		{
			"binding": "APP_DB",
			"database_name": "chiridion-app-dev-illiana-db",
			"database_id": "5c2ede0c-5b0c-47db-a69d-b15e0d423de7",
			"migrations_dir": "migrations"
		}
	],
	"queues": {
		"producers": [
			{ "binding": "APP_SCREENSHOT_QUEUE", "queue": "chiridion-app-screenshots-dev-illiana" },
			{ "binding": "SLACK_EVENTS_QUEUE", "queue": "chiridion-app-slack-events-dev-illiana" }
		],
		"consumers": [
			{ "queue": "chiridion-app-screenshots-dev-illiana" },
			{ "queue": "chiridion-app-slack-events-dev-illiana" }
		]
	},
	"services": [
		{ "binding": "WORKER_SELF_REFERENCE", "service": "chiridion-app-dev-illiana" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
			{ "name": "USER", "class_name": "UserDO" },
			{ "name": "ORG", "class_name": "OrgDO" },
			{ "name": "ORG_SLUG", "class_name": "OrgSlugDO" },
			{ "name": "EMAIL_HANDLE", "class_name": "EmailHandleDO" },
			{ "name": "TELEGRAM_REGISTRY", "class_name": "TelegramRegistryDO" },
			{ "name": "SLACK_TEAM_REGISTRY", "class_name": "SlackTeamRegistryDO" },
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
			{ "name": "WORKSPACE_CRON", "class_name": "WorkspaceCronDO" },
			{ "name": "MCP_OBJECT", "class_name": "ChiridionMcp" },
				{ "name": "WORKER_LOGS", "class_name": "WorkerLogsDO" },
				{ "name": "WORKSPACE_FS", "class_name": "WorkspaceFilesystemDO" },
				{ "name": "MIGRATION_PLANNING_AGENT", "class_name": "MigrationPlanningAgent" },
			]
		},
	"workflows": [
		{
			"name": "chiridion-deterministic-automations-dev-illiana",
			"binding": "DETERMINISTIC_AUTOMATION_WORKFLOWS",
			"class_name": "DeterministicAutomationWorkflow"
		},
		{
			"name": "chiridion-legacy-workspace-migrations-dev-illiana",
			"binding": "LEGACY_WORKSPACE_MIGRATIONS",
			"class_name": "LegacyWorkspaceMigrationWorkflow"
		}
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatDurableObject"] },
		{ "tag": "v2", "deleted_classes": ["ChatDurableObject"] },
		{ "tag": "v3", "new_sqlite_classes": ["ChatThreadDO", "ChatIndexDO"] },
		{ "tag": "v4", "new_sqlite_classes": ["ThreadSandbox"] },
		{ "tag": "v5", "new_sqlite_classes": ["SessionDO", "UserDO", "OrgDO"] },
		{ "tag": "v6", "new_sqlite_classes": ["WorkspaceDO"] },
		{ "tag": "v7", "deleted_classes": ["SessionDO"] },
		{ "tag": "v8", "deleted_classes": ["ChatIndexDO"] },
		{ "tag": "v9", "new_sqlite_classes": ["ChiridionMcp"] },
		{ "tag": "v10", "new_sqlite_classes": ["OrgSlugDO"] },
		{ "tag": "v11", "new_sqlite_classes": ["MssqlProxy"] },
		{ "tag": "v12", "deleted_classes": ["MssqlProxy"], "new_sqlite_classes": ["DataProxy"] },
		{ "tag": "v13", "deleted_classes": ["ThreadSandbox"] },
		{ "tag": "v14", "new_sqlite_classes": ["WorkerLogsDO"] },
		{ "tag": "v15", "new_sqlite_classes": ["AdminIndexDO"] },
		{ "tag": "v16", "deleted_classes": ["DataProxy"] },
		{ "tag": "v17", "new_sqlite_classes": ["OAuthStateDO"] },
		{ "tag": "v18", "new_sqlite_classes": ["WorkspaceCronDO"] },
		{ "tag": "v19", "deleted_classes": ["OAuthStateDO"] },
		{ "tag": "v20", "new_sqlite_classes": ["EmailHandleDO"] },
		{ "tag": "v21", "new_classes": ["EphemeralWorkerLogsDO"] },
		{ "tag": "v22", "deleted_classes": ["AdminIndexDO"] },
		{ "tag": "v23", "new_sqlite_classes": ["TelegramRegistryDO", "SlackTeamRegistryDO"] },
		{ "tag": "v24", "new_sqlite_classes": ["CloudflareSandbox"] },
		{ "tag": "v25", "new_sqlite_classes": ["WorkspaceFilesystemDO"] },
			{ "tag": "v27", "new_sqlite_classes": ["MigrationPlanningAgent"] }
		]
	}
