{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Config used only by `initOpenNextCloudflareForDev()` during `next dev`.
	// Keep this lightweight: Durable Objects needed by Next.js API routes, but
	// no containers (those require build IDs and aren't needed for HMR).
	"name": "chiridion-app-nextdev",
	"main": "worker/index.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"]
}
