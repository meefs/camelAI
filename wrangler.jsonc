{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-app",
	"main": "workers/main/src/index.ts",
	"compatibility_date": "2025-12-01",
	"keep_names": false,
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Dev defaults (inherited by all envs, overridden by prod/staging)
	"vars": {
		"R2_BUCKET_NAME": "chiridion-sandbox",
		"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
		"R2_MOUNT_DIR": "/home/claude",
		"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
		"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
		"CF_DISPATCH_NAMESPACE": "chiridion-platform",
		"WORKER_BASE_URL": "http://localhost:8787"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"ai": {
		"binding": "AI"
	},
	"analytics_engine_datasets": [
		{
			"binding": "ERROR_ANALYTICS",
			"dataset": "chiridion_errors"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "chiridion-sandbox"
		}
	],
	// Shared dev/staging KV namespaces
	"kv_namespaces": [
		{
			"binding": "EMAIL_TO_USER",
			"id": "ab267c4f44b847dda8bdca400a4e1884"
		},
		{
			"binding": "API_TOKENS",
			"id": "e894eb2caf1641ad8870da994b992fce"
		},
		{
			"binding": "SESSIONS",
			"id": "f5ab08fdb1d7404fbc45a171217b4a27"
		}
	],
	"containers": [
		{
			"class_name": "ThreadSandbox",
			"image": "./Dockerfile",
			"instance_type": "basic",
			"max_instances": 5
		}
	],
	// Service bindings for local dev (without --env flag)
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "chiridion-app"
		},
		{
			"binding": "DO_RPC",
			"service": "chiridion-app",
			"entrypoint": "DoRpcService"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_INDEX", "class_name": "ChatIndexDO" },
			{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
			{ "name": "SANDBOX", "class_name": "ThreadSandbox" },
						{ "name": "USER", "class_name": "UserDO" },
			{ "name": "ORG", "class_name": "OrgDO" },
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatDurableObject"] },
		{ "tag": "v2", "deleted_classes": ["ChatDurableObject"] },
		{ "tag": "v3", "new_sqlite_classes": ["ChatThreadDO", "ChatIndexDO"] },
		{ "tag": "v4", "new_sqlite_classes": ["ThreadSandbox"] },
		{ "tag": "v5", "new_sqlite_classes": ["SessionDO", "UserDO", "OrgDO"] },
		{ "tag": "v6", "new_sqlite_classes": ["WorkspaceDO"] },
		{ "tag": "v7", "deleted_classes": ["SessionDO"] }
	],
	"env": {
		"prod": {
			"name": "chiridion-app",
			"routes": [
				{ "pattern": "chiridion.ai/*", "zone_name": "chiridion.ai" },
				{ "pattern": "www.chiridion.ai/*", "zone_name": "chiridion.ai" }
			],
			"vars": {
				"R2_BUCKET_NAME": "chiridion-sandbox",
				"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"R2_MOUNT_DIR": "/home/claude",
				"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
				"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"CF_DISPATCH_NAMESPACE": "chiridion-platform",
				"WORKER_BASE_URL": "https://chiridion.ai"
			},
			"images": {
				"binding": "IMAGES"
			},
			"ai": {
				"binding": "AI"
			},
			"r2_buckets": [
				{
					"binding": "R2_BUCKET",
					"bucket_name": "chiridion-sandbox"
				}
			],
			// Prod KV namespaces
			"kv_namespaces": [
				{
					"binding": "EMAIL_TO_USER",
					"id": "45b452b3b19c42f6991408c140149a70"
				},
				{
					"binding": "API_TOKENS",
					"id": "0ee80299e67c4c7fa0c1ad618b7e7a9c"
				},
				{
					"binding": "SESSIONS",
					"id": "67958a5b0d104621bd93c91c802ccd1c"
				}
			],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "chiridion-app"
				},
				{
					"binding": "DO_RPC",
					"service": "chiridion-app",
					"entrypoint": "DoRpcService"
				}
			],
			"containers": [
				{
					"class_name": "ThreadSandbox",
					"image": "./Dockerfile",
					"instance_type": "standard-1",
					"max_instances": 50
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "CHAT_INDEX", "class_name": "ChatIndexDO" },
					{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
					{ "name": "SANDBOX", "class_name": "ThreadSandbox" },
										{ "name": "USER", "class_name": "UserDO" },
					{ "name": "ORG", "class_name": "OrgDO" },
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }
				]
			}
		},
		"staging": {
			"name": "chiridion-app-staging",
			"routes": [
				{ "pattern": "staging.chiridion.ai/*", "zone_name": "chiridion.ai" }
			],
			"vars": {
				"R2_BUCKET_NAME": "chiridion-sandbox",
				"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"R2_MOUNT_DIR": "/home/claude",
				"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
				"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"CF_DISPATCH_NAMESPACE": "chiridion-platform",
				"WORKER_BASE_URL": "https://staging.chiridion.ai"
			},
			"assets": {
				"binding": "ASSETS",
				"directory": ".open-next/assets"
			},
			"images": {
				"binding": "IMAGES"
			},
			"ai": {
				"binding": "AI"
			},
			"r2_buckets": [
				{
					"binding": "R2_BUCKET",
					"bucket_name": "chiridion-sandbox"
				}
			],
			"kv_namespaces": [
				{
					"binding": "EMAIL_TO_USER",
					"id": "ab267c4f44b847dda8bdca400a4e1884"
				},
				{
					"binding": "API_TOKENS",
					"id": "e894eb2caf1641ad8870da994b992fce"
				},
				{
					"binding": "SESSIONS",
					"id": "f5ab08fdb1d7404fbc45a171217b4a27"
				}
			],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "chiridion-app-staging"
				},
				{
					"binding": "DO_RPC",
					"service": "chiridion-app-staging",
					"entrypoint": "DoRpcService"
				}
			],
			"containers": [
				{
					"class_name": "ThreadSandbox",
					"image": "./Dockerfile",
					"instance_type": "standard-1",
					"max_instances": 5
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "CHAT_INDEX", "class_name": "ChatIndexDO" },
					{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
					{ "name": "SANDBOX", "class_name": "ThreadSandbox" },
										{ "name": "USER", "class_name": "UserDO" },
					{ "name": "ORG", "class_name": "OrgDO" },
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }
				]
			}
		},
		"dev-miguel": {
			"name": "chiridion-app-dev-miguel",
			"routes": [
				{ "pattern": "dev-miguel.chiridion.ai/*", "zone_name": "chiridion.ai" }
			],
			"vars": {
				"R2_BUCKET_NAME": "chiridion-sandbox",
				"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"R2_MOUNT_DIR": "/home/claude",
				"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
				"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"CF_DISPATCH_NAMESPACE": "chiridion-platform",
				"WORKER_BASE_URL": "https://dev-miguel.chiridion.ai"
			},
			"assets": {
				"binding": "ASSETS",
				"directory": ".open-next/assets"
			},
			"images": {
				"binding": "IMAGES"
			},
			"ai": {
				"binding": "AI"
			},
			"r2_buckets": [
				{
					"binding": "R2_BUCKET",
					"bucket_name": "chiridion-sandbox"
				}
			],
			// Dedicated KV namespace for dev-miguel (prevents cross-env data contamination)
			"kv_namespaces": [
				{
					"binding": "EMAIL_TO_USER",
					"id": "06c511f882d041ea89a98cb413f4b2f3"
				},
				{
					"binding": "API_TOKENS",
					"id": "e894eb2caf1641ad8870da994b992fce"
				},
				{
					"binding": "SESSIONS",
					"id": "a38773869d2e465fbf705c81fa2e01eb"
				}
			],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "chiridion-app-dev-miguel"
				},
				{
					"binding": "DO_RPC",
					"service": "chiridion-app-dev-miguel",
					"entrypoint": "DoRpcService"
				}
			],
			"containers": [
				{
					"class_name": "ThreadSandbox",
					"image": "./Dockerfile",
					"instance_type": "standard-1",
					"max_instances": 5
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "CHAT_INDEX", "class_name": "ChatIndexDO" },
					{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
					{ "name": "SANDBOX", "class_name": "ThreadSandbox" },
										{ "name": "USER", "class_name": "UserDO" },
					{ "name": "ORG", "class_name": "OrgDO" },
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }
				]
			}
		},
		"dev-illiana": {
			"name": "chiridion-app-dev-illiana",
			"routes": [
				{ "pattern": "dev-illiana.chiridion.ai/*", "zone_name": "chiridion.ai" }
			],
			"vars": {
				"R2_BUCKET_NAME": "chiridion-sandbox",
				"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"R2_MOUNT_DIR": "/home/claude",
				"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
				"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"CF_DISPATCH_NAMESPACE": "chiridion-platform",
				"WORKER_BASE_URL": "https://dev-illiana.chiridion.ai"
			},
			"assets": {
				"binding": "ASSETS",
				"directory": ".open-next/assets"
			},
			"images": {
				"binding": "IMAGES"
			},
			"ai": {
				"binding": "AI"
			},
			"r2_buckets": [
				{
					"binding": "R2_BUCKET",
					"bucket_name": "chiridion-sandbox"
				}
			],
			// Dedicated KV namespace for dev-illiana (prevents cross-env data contamination)
			"kv_namespaces": [
				{
					"binding": "EMAIL_TO_USER",
					"id": "b5d67155aac54d208f00fc5d51f2d080"
				},
				{
					"binding": "API_TOKENS",
					"id": "e894eb2caf1641ad8870da994b992fce"
				},
				{
					"binding": "SESSIONS",
					"id": "c632a963433e4949b6dea43728034b36"
				}
			],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "chiridion-app-dev-illiana"
				},
				{
					"binding": "DO_RPC",
					"service": "chiridion-app-dev-illiana",
					"entrypoint": "DoRpcService"
				}
			],
			"containers": [
				{
					"class_name": "ThreadSandbox",
					"image": "./Dockerfile",
					"instance_type": "basic",
					"max_instances": 5
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "CHAT_INDEX", "class_name": "ChatIndexDO" },
					{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
					{ "name": "SANDBOX", "class_name": "ThreadSandbox" },
										{ "name": "USER", "class_name": "UserDO" },
					{ "name": "ORG", "class_name": "OrgDO" },
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }
				]
			}
		}
	}
}
