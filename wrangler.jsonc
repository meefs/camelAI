{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-app",
	"main": "workers/main/src/index.ts",
	"compatibility_date": "2025-12-01",
	"keep_names": false,
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Local dev defaults (overridden by prod/staging/dev-* envs)
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
		"R2_BUCKET_NAME": "chiridion-sandbox",
		"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
		"R2_MOUNT_DIR": "/home/claude",
		"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
		"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
		"CF_DISPATCH_NAMESPACE": "chiridion-platform-local",
		"CF_WORKER_NAME": "chiridion-app",
		// Claude API proxy (CF AI Gateway)
		"CF_GATEWAY_NAME": "chiridion",
		"BEDROCK_REGION": "us-west-2",
		"EMAIL_FROM_ADDRESS": "no-reply@mail.camelai.com"
		// CF_GATEWAY_TOKEN is set via .dev.vars
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "build/client"
	},
	"images": {
		"binding": "IMAGES"
	},
	"browser": {
		"binding": "BROWSER"
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"analytics_engine_datasets": [
		{
			"binding": "ERROR_ANALYTICS",
			"dataset": "chiridion_errors"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "chiridion-sandbox",
      "remote": true
		}
	],
	// Shared dev/staging KV namespaces
	"kv_namespaces": [
		{
			"binding": "EMAIL_TO_USER",
			"id": "ab267c4f44b847dda8bdca400a4e1884"
		},
		{
			"binding": "APP_KV",
			"id": "e894eb2caf1641ad8870da994b992fce"
		},
		{
			"binding": "SESSIONS",
			"id": "f5ab08fdb1d7404fbc45a171217b4a27"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "APP_SCREENSHOT_QUEUE",
				"queue": "chiridion-app-screenshots-local"
			},
			{
				"binding": "SLACK_EVENTS_QUEUE",
				"queue": "chiridion-app-slack-events-local"
			}
		],
		"consumers": [
			{
				"queue": "chiridion-app-screenshots-local"
			},
			{
				"queue": "chiridion-app-slack-events-local"
			}
		]
	},
	// Service bindings for local dev (without --env flag)
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "chiridion-app"
		}
	],
	"vpc_services": [
		{
			"binding": "SANDBOX_HOST",
			"service_id": "019c54ff-d555-7741-8464-3b68f8a18edf",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
			{ "name": "USER", "class_name": "UserDO" },
			{ "name": "ORG", "class_name": "OrgDO" },
			{ "name": "ORG_SLUG", "class_name": "OrgSlugDO" },
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
			{ "name": "MCP_OBJECT", "class_name": "ChiridionMcp" },
			{ "name": "WORKER_LOGS", "class_name": "WorkerLogsDO" },
			{ "name": "ADMIN_INDEX", "class_name": "AdminIndexDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatDurableObject"] },
		{ "tag": "v2", "deleted_classes": ["ChatDurableObject"] },
		{ "tag": "v3", "new_sqlite_classes": ["ChatThreadDO", "ChatIndexDO"] },
		{ "tag": "v4", "new_sqlite_classes": ["ThreadSandbox"] },
		{ "tag": "v5", "new_sqlite_classes": ["SessionDO", "UserDO", "OrgDO"] },
		{ "tag": "v6", "new_sqlite_classes": ["WorkspaceDO"] },
		{ "tag": "v7", "deleted_classes": ["SessionDO"] },
		{ "tag": "v8", "deleted_classes": ["ChatIndexDO"] },
		{ "tag": "v9", "new_sqlite_classes": ["ChiridionMcp"] },
		{ "tag": "v10", "new_sqlite_classes": ["OrgSlugDO"] },
		{ "tag": "v11", "new_sqlite_classes": ["MssqlProxy"] },
		{ "tag": "v12", "deleted_classes": ["MssqlProxy"], "new_sqlite_classes": ["DataProxy"] },
		{ "tag": "v13", "deleted_classes": ["ThreadSandbox"] },
		{ "tag": "v14", "new_sqlite_classes": ["WorkerLogsDO"] },
		{ "tag": "v15", "new_sqlite_classes": ["AdminIndexDO"] },
		{ "tag": "v16", "deleted_classes": ["DataProxy"] }
	],
	"env": {
		"prod": {
			"name": "chiridion-app",
			"routes": [
				{ "pattern": "camelai.dev/*", "zone_name": "camelai.dev" },
				{ "pattern": "www.camelai.dev/*", "zone_name": "camelai.dev" }
			],
			"vpc_services": [
				{
					"binding": "SANDBOX_HOST",
					"service_id": "019c54ff-d555-7741-8464-3b68f8a18edf"
				}
			],
			"vars": {
				"AI_VIRTUAL_MODEL": "dynamic/auto",
				"R2_BUCKET_NAME": "chiridion-sandbox",
				"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"R2_MOUNT_DIR": "/home/claude",
				"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
				"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
				"CF_DISPATCH_NAMESPACE": "chiridion-platform",
				"CF_WORKER_NAME": "chiridion-app",
				"TAIL_WORKER_NAME": "chiridion-user-logs-tail",
				"WORKER_BASE_URL": "https://camelai.dev",
				"CF_GATEWAY_NAME": "chiridion",
				"BEDROCK_REGION": "us-west-2",
				"EMAIL_FROM_ADDRESS": "no-reply@mail.camelai.com"
				// CF_GATEWAY_TOKEN is set via secrets
			},
			"images": {
				"binding": "IMAGES"
			},
			"browser": {
				"binding": "BROWSER"
			},
			"ai": {
				"binding": "AI",
				"remote": true
			},
			"r2_buckets": [
				{
					"binding": "R2_BUCKET",
					"bucket_name": "chiridion-sandbox"
				}
			],
			// Prod KV namespaces
			"kv_namespaces": [
				{
					"binding": "EMAIL_TO_USER",
					"id": "45b452b3b19c42f6991408c140149a70"
				},
				{
					"binding": "APP_KV",
					"id": "0ee80299e67c4c7fa0c1ad618b7e7a9c"
