			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "chiridion-app"
				}
			],
			"analytics_engine_datasets": [
				{
					"binding": "ERROR_ANALYTICS",
					"dataset": "chiridion_errors_prod"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
					{ "name": "USER", "class_name": "UserDO" },
					{ "name": "ORG", "class_name": "OrgDO" },
					{ "name": "ORG_SLUG", "class_name": "OrgSlugDO" },
					{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
					{ "name": "MCP_OBJECT", "class_name": "ChiridionMcp" },
					{ "name": "WORKER_LOGS", "class_name": "WorkerLogsDO" },
			{ "name": "ADMIN_INDEX", "class_name": "AdminIndexDO" }
				]
			}
		},
		"staging": {
			"name": "chiridion-app-staging",
			"routes": [
