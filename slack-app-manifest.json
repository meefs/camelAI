{
  "display_information": {
    "name": "camelAI",
    "description": "AI coding assistant integration for camelAI workspaces",
    "background_color": "#18181b",
    "long_description": "camelAI is an AI coding assistant that can interact with your Slack workspace. This integration allows camelAI to read messages, post updates, manage channels, and help automate workflows in your Slack workspace."
  },
  "features": {
    "bot_user": {
      "display_name": "camelAI",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/camelai",
        "description": "Interact with camelAI assistant",
        "usage_hint": "[message or command]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://camelai.dev/api/integrations/slack/callback",
      "https://staging.camelai.dev/api/integrations/slack/callback",
      "https://dev-miguel.camelai.dev/api/integrations/slack/callback",
      "https://dev-illiana.camelai.dev/api/integrations/slack/callback",
      "http://localhost:3001/api/integrations/slack/callback"
    ],
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "chat:write.customize",
        "im:write",
        "im:read",
        "im:history",
        "mpim:write",
        "mpim:read",
        "mpim:history",
        "channels:read",
        "channels:history",
        "channels:join",
        "channels:manage",
        "groups:read",
        "groups:history",
        "groups:write",
        "users:read",
        "users:read.email",
        "users.profile:read",
        "team:read",
        "files:read",
        "files:write",
        "reactions:read",
        "reactions:write",
        "pins:read",
        "pins:write",
        "bookmarks:read",
        "bookmarks:write",
        "reminders:read",
        "reminders:write",
        "usergroups:read",
        "usergroups:write",
        "calls:read",
        "calls:write",
        "canvases:read",
        "canvases:write",
        "workflow.steps:execute",
        "commands",
        "app_mentions:read",
        "metadata.message:read",
        "links:read",
        "links:write",
        "dnd:read"
      ],
      "user": [
        "channels:read",
        "channels:history",
        "channels:write",
        "groups:read",
        "groups:history",
        "groups:write",
        "im:read",
        "im:history",
        "im:write",
        "mpim:read",
        "mpim:history",
        "mpim:write",
        "chat:write",
        "files:read",
        "files:write",
        "users:read",
        "users:read.email",
        "users.profile:read",
        "users.profile:write",
        "team:read",
        "reactions:read",
        "reactions:write",
        "pins:read",
        "pins:write",
        "reminders:read",
        "reminders:write",
        "search:read",
        "stars:read",
        "stars:write",
        "usergroups:read",
        "usergroups:write",
        "identify"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
