environment          = "prod"
location             = "eastus"
vm_size              = "Standard_E64ds_v5"
admin_username       = "chiridion"
ssh_public_key       = "ssh-ed25519 AAAA... user@host"
storage_account_name = "chiridionstoragefiles"
nfs_share_name       = "workspaces"
nfs_share_quota_gb   = 2048
os_disk_size_gb      = 128

# Restrict SSH to your IP in production
ssh_allowed_cidr          = "*"
sandbox_host_allowed_cidr = "0.0.0.0/0"

# Auto-generated if left empty
# sandbox_host_token = ""
