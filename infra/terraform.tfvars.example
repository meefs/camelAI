environment       = "prod"
location          = "centralus"
availability_zone = "1"
vm_size           = "Standard_E64as_v7"
admin_username    = "chiridion"
ssh_public_key    = "ssh-ed25519 AAAA... user@host"
os_disk_size_gb   = 128

sandbox_data_disk_size_gb = 2048
sandbox_data_disk_iops    = 5000
sandbox_data_disk_mbps    = 200
sandbox_data_disk_lun     = 0

# Cloudflare tunnel token used by cloudflared on the VM
cloudflared_tunnel_token  = "eyJ...replace-me..."

# Sandbox host auth
sandbox_proxy_secret      = "replace-with-hex-secret"
sandbox_proxy_port        = 8081

# R2 credentials for sandbox-host (permanent keys, used by host-level s3fs mount)
r2_access_key_id          = "replace-with-r2-access-key-id"
r2_secret_access_key      = "replace-with-r2-secret-access-key"
r2_account_id             = "85bbd288051330fb51ee1c86031a299b"
r2_bucket_name            = "chiridion-sandbox"

# AI Gateway credentials for sandbox-host OpenAI-compatible proxy
cf_account_id             = "85bbd288051330fb51ee1c86031a299b"
cf_gateway_name           = "chiridion"
cf_gateway_token          = "replace-with-cf-gateway-token"

# Exa credentials for host-side Pi WebSearch/WebFetch tools
exa_api_key               = "replace-with-exa-api-key"
