{
  admin off
  log {
    output discard
  }
}

PROXY_HOSTNAME {
  log {
    output discard
  }

  route {
    @health path /healthz
    handle @health {
      reverse_proxy http://camelai-codex-inference-relay:8787
    }

    @codex path /backend-api/codex/*
    handle @codex {
      @authorized header X-CamelAI-Proxy-Token {$PROXY_TOKEN}
      handle @authorized {
        reverse_proxy http://camelai-codex-inference-relay:8787 {
          header_up -X-CamelAI-Proxy-Token
          header_down -Set-Cookie
          flush_interval -1
        }
      }
      respond "Forbidden" 403
    }

    respond "Not Found" 404
  }
}
