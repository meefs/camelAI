# Select one: aws, azure, or gcp.
cloud_provider = "aws"
name           = "camelai-selfhost"

# Prebuilt images pulled by cloud-init on first boot.
app_image_uri             = "904534089871.dkr.ecr.us-west-2.amazonaws.com/camelai-selfhost-app:test-latest"
local_artifacts_image_uri = "904534089871.dkr.ecr.us-west-2.amazonaws.com/camelai-selfhost-local-artifacts:test-latest"

# The project runtime service is still cloned so the host can build Dockerfile.sandbox
# and run the Go control-plane service.
runtime_repository_url = "https://github.com/YOUR_ORG/project-runtime-service.git"
runtime_repository_ref = "main"

# DNS must point to the output public_ip before Caddy can issue HTTPS certs.
public_base_url  = "https://camel.example.com"
app_vanity_domain = "apps.example.com"
# app_iframe_domain = "apps.example.com"

# Cloudflare Tunnel + Access is the recommended AWS ingress path.
# Configure two tunnel public hostnames targeting http://localhost:3001:
#   camel.example.com
#   *.apps.example.com
cloudflared_tunnel_token = ""
cloudflare_access_team_domain = "https://your-team.cloudflareaccess.com"
cloudflare_access_aud = "your-access-aud"
cloudflare_access_default_org_name = "Your Organization"
# cloudflare_access_required_email_domain = "example.com"
local_auth_bypass = "0"
enable_public_ingress = false

# AI provider. AWS defaults to Bedrock through the EC2 instance role, so no
# API key is required when using selfhost_ai_provider = "bedrock".
# selfhost_ai_provider      = "bedrock"
# selfhost_ai_aws_region    = "us-east-1"
# For non-AWS providers, set a key explicitly:
# selfhost_ai_provider = "openrouter"
# selfhost_ai_api_key  = "sk-or-..."
# selfhost_ai_model    = "anthropic/claude-sonnet-4"

# Optional SSH access. Leave ssh_cidr blank to disable public SSH.
ssh_user       = "ubuntu"
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
ssh_cidr       = "203.0.113.10/32"

# AWS settings.
aws_region        = "us-east-1"
aws_instance_type = "t3a.xlarge"
# aws_vpc_id      = "vpc-..."
# aws_subnet_id   = "subnet-..."
# aws_key_name    = "existing-keypair"

# Azure settings.
# cloud_provider  = "azure"
# azure_location  = "eastus"
# azure_vm_size   = "Standard_D4s_v5"

# GCP settings.
# cloud_provider   = "gcp"
# gcp_project_id   = "my-project"
# gcp_region       = "us-central1"
# gcp_zone         = "us-central1-a"
# gcp_machine_type = "e2-standard-4"
