{
	"name": "chiridion-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "node scripts/dev-proxy.mjs",
		"dev:next": "next dev -p 3000",
		"dev:wrangler": "wrangler dev -c wrangler-dev.jsonc --local --port 8787",
		"build": "next build",
		"build:cf": "opennextjs-cloudflare build -c wrangler.build.jsonc",
		"start": "next start",
		"lint": "next lint",
		"deploy": "npm run build:cf && OPEN_NEXT_DEPLOY=true wrangler deploy -c wrangler.jsonc",
		"deploy:staging": "npm run build:cf && OPEN_NEXT_DEPLOY=true wrangler deploy -c wrangler.jsonc --env staging",
		"upload": "npm run build:cf && opennextjs-cloudflare upload",
		"preview": "npm run build:cf && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.14.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.562.0",
		"next": "15.5.9",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "19.1.4",
		"react-dom": "19.1.4",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@cloudflare/sandbox": "^0.6.6",
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.57.0",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^20.19.27",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5.1.2",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"http-proxy": "^1.18.1",
		"jsdom": "^27.3.0",
		"shadcn": "^3.6.2",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5",
		"vitest": "^4.0.15",
		"wrangler": "^4.55.0"
	}
}
