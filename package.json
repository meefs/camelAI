{
	"name": "chiridion-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "npm run build:cf && wrangler dev -c wrangler.jsonc --local",
		"build": "next build",
		"build:cf": "opennextjs-cloudflare build -c wrangler.build.jsonc",
		"start": "next start",
		"lint": "next lint",
		"deploy": "npm run build:cf && OPEN_NEXT_DEPLOY=true wrangler deploy -c wrangler.jsonc",
		"deploy:staging": "npm run build:cf && OPEN_NEXT_DEPLOY=true wrangler deploy -c wrangler.jsonc --env staging",
		"upload": "npm run build:cf && opennextjs-cloudflare upload",
		"preview": "npm run build:cf && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.14.4",
		"next": "15.5.9",
		"react": "19.1.4",
		"react-dom": "19.1.4"
	},
	"devDependencies": {
		"@cloudflare/sandbox": "^0.6.6",
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.57.0",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^20.19.27",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5.1.2",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"jsdom": "^27.3.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.0.15",
		"wrangler": "^4.55.0"
	}
}
