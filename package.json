{
	"name": "chiridion-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build:sprite-assets": "node scripts/build-sprite-assets.mjs",
		"dev": "bun run build:sprite-assets && react-router dev",
		"build": "bun run build:sprite-assets && react-router build",
		"build:cf": "bun run build:sprite-assets && react-router build",
		"start": "wrangler dev",
		"lint": "eslint .",
		"typecheck": "bun run build:sprite-assets && react-router typegen && tsc",
		"deploy:main:prod": "node scripts/deploy-main.mjs prod",
		"deploy:main:staging": "node scripts/deploy-main.mjs staging",
		"deploy:main:dev-miguel": "node scripts/deploy-main.mjs dev-miguel",
		"deploy:main:dev-illiana": "node scripts/deploy-main.mjs dev-illiana",
		"deploy:dispatcher:prod": "wrangler deploy -c workers/dispatcher/wrangler.prod.jsonc",
		"deploy:dispatcher:staging": "wrangler deploy -c workers/dispatcher/wrangler.staging.jsonc",
		"deploy:dispatcher:dev-miguel": "wrangler deploy -c workers/dispatcher/wrangler.dev-miguel.jsonc",
		"deploy:dispatcher:dev-illiana": "wrangler deploy -c workers/dispatcher/wrangler.dev-illiana.jsonc",
		"deploy:dispatcher:local": "wrangler deploy -c workers/dispatcher/wrangler.jsonc --env local",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"test:all": "npm run test:run && npm run test:workers",
		"test:workers": "bun run build:sprite-assets && vitest run --config vitest.workers.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"admin": "node workers/admin-cli/cli.mjs",
		"admin:staging": "wrangler dev --config workers/admin-cli/wrangler.jsonc",
		"admin:prod": "wrangler dev --config workers/admin-cli/wrangler.jsonc --env prod",
		"admin:dev-illiana": "wrangler dev --config workers/admin-cli/wrangler.jsonc --env dev-illiana",
		"admin:dev-miguel": "wrangler dev --config workers/admin-cli/wrangler.jsonc --env dev-miguel"
	},
	"dependencies": {
		"@anthropic-ai/bedrock-sdk": "^0.26.0",
		"@anthropic-ai/claude-agent-sdk": "0.2.37",
		"@anthropic-ai/foundry-sdk": "^0.2.0",
		"@anthropic-ai/sdk": "^0.71.2",
		"@cloudflare/containers": "^0.0.31",
		"@cloudflare/vite-plugin": "1.22.1",
		"@conform-to/react": "^1.15.1",
		"@conform-to/zod": "^1.15.1",
		"@fly/sprites": "^0.0.1",
		"@modelcontextprotocol/sdk": "^1.25.2",
		"@monaco-editor/react": "^4.7.0",
		"@react-email/components": "^1.0.7",
		"@react-email/render": "^2.0.4",
		"@react-router/cloudflare": "^7.6.1",
		"@shikijs/rehype": "^3.20.0",
		"agents": "^0.3.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cookie": "^1.0.2",
		"isbot": "^5.1.17",
		"lucide-react": "^0.562.0",
		"monaco-editor": "^0.55.1",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.1.1",
		"react-router": "^7.6.1",
		"remark-gfm": "^4.0.1",
		"shiki": "^3.20.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@ast-grep/cli": "^0.40.5",
		"@cloudflare/puppeteer": "^0.0.11",
		"@cloudflare/vitest-pool-workers": "^0.11.1",
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.57.0",
		"@react-router/dev": "^7.6.1",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/cookie": "^1.0.0",
		"@types/node": "^20.19.27",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5.1.2",
		"eslint": "^9",
		"jsdom": "^27.3.0",
		"png-to-ico": "^3.0.1",
		"shadcn": "^3.6.2",
		"sharp": "^0.34.5",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5",
		"vite": "8.0.0-beta.11",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4",
		"wrangler": "^4.59.3"
	},
	"overrides": {
		"vite": "$vite"
	}
}
