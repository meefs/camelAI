{
	"name": "chiridion-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "desktop/electron/main.mjs",
	"scripts": {
		"dev": "react-router dev",
		"build": "react-router build",
		"build:cf": "react-router build",
		"start": "wrangler dev",
		"desktop:dev": "node desktop/scripts/dev.mjs",
		"desktop:backend": "bun run desktop/backend/server.ts",
		"desktop:stage": "node desktop/scripts/stage.mjs",
		"desktop:icons": "node desktop/scripts/build-icons.mjs",
		"desktop:renderer": "vite --config desktop/vite.config.ts",
		"desktop:renderer:build": "vite build --config desktop/vite.config.ts",
		"desktop:probe-startup": "node desktop/scripts/probe-startup.mjs",
		"desktop:probe-turn": "node desktop/scripts/probe-turn.mjs",
		"desktop:probe:speed": "bun desktop/scripts/probe-speed.mjs",
		"desktop:probe": "node desktop/scripts/probe.mjs",
		"desktop:probe:staged": "node desktop/scripts/probe.mjs --staged",
		"desktop:start": "electron desktop/electron/main.mjs",
		"desktop:start:staged": "DESKTOP_APP_RESOURCES_DIR=desktop/app-resources electron desktop/electron/main.mjs",
		"desktop:dist:mac": "bun run desktop:stage && bun run desktop:icons && electron-builder --config desktop/electron-builder.yml --mac dmg zip --publish never",
		"desktop:dist:mac:unsigned": "bun run desktop:stage && bun run desktop:icons && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config desktop/electron-builder.yml --mac dmg zip --publish never -c.mac.identity=null -c.mac.notarize=false",
		"desktop:check": "tsc -p desktop/tsconfig.json --noEmit",
		"desktop-agentos:dev": "node desktop-agentos/scripts/dev.mjs",
		"desktop-agentos:backend": "node --import tsx/esm desktop-agentos/scripts/backend-smoke.mjs",
		"desktop-agentos:probe-acp": "node --import tsx/esm desktop-agentos/scripts/probe-acp-stream.mjs",
		"desktop-agentos:probe-resume": "node --import tsx/esm desktop-agentos/scripts/probe-session-resume.mjs",
		"desktop-agentos:test-gpt54": "node --import tsx/esm desktop-agentos/scripts/test-gpt54-acp.mjs",
		"desktop-agentos:test-openrouter": "node --import tsx/esm desktop-agentos/scripts/test-openrouter-acp.mjs",
		"desktop-agentos:probe-turn": "node desktop-agentos/scripts/probe-turn.mjs",
		"desktop-agentos:start": "NODE_OPTIONS='--import tsx/esm' electron desktop-agentos/electron/main.mjs",
		"desktop-agentos:check": "tsc -p desktop-agentos/tsconfig.json --noEmit",
		"desktop-agentos:install": "cd desktop-agentos && bun install",
		"desktop:runtime-helper:build": "node desktop/scripts/prepare-runtime-helper.mjs",
		"desktop:runtime-image:publish": "node desktop/scripts/publish-runtime-image.mjs",
		"lint": "eslint .",
		"typecheck": "react-router typegen && tsc",
		"deploy:main:prod": "node scripts/deploy-main.mjs prod",
		"deploy:main:staging": "node scripts/deploy-main.mjs staging",
		"deploy:main:dev-miguel": "node scripts/deploy-main.mjs dev-miguel",
		"deploy:main:dev-illiana": "node scripts/deploy-main.mjs dev-illiana",
		"deploy:dispatcher:prod": "wrangler deploy -c workers/dispatcher/wrangler.prod.jsonc",
		"deploy:dispatcher:staging": "wrangler deploy -c workers/dispatcher/wrangler.staging.jsonc",
		"deploy:dispatcher:dev-miguel": "wrangler deploy -c workers/dispatcher/wrangler.dev-miguel.jsonc",
		"deploy:dispatcher:dev-illiana": "wrangler deploy -c workers/dispatcher/wrangler.dev-illiana.jsonc",
		"deploy:dispatcher:local": "wrangler deploy -c workers/dispatcher/wrangler.jsonc --env local",
		"deploy:tail:prod": "wrangler deploy -c workers/user-logs-tail/wrangler.jsonc --env prod",
		"deploy:tail:staging": "wrangler deploy -c workers/user-logs-tail/wrangler.jsonc --env staging",
		"deploy:tail:dev-miguel": "wrangler deploy -c workers/user-logs-tail/wrangler.jsonc --env dev-miguel",
		"deploy:tail:dev-illiana": "wrangler deploy -c workers/user-logs-tail/wrangler.jsonc --env dev-illiana",
		"deploy:bedrock-provider:prod": "wrangler deploy -c workers/bedrock-provider/wrangler.jsonc --env prod",
		"deploy:bedrock-provider:staging": "wrangler deploy -c workers/bedrock-provider/wrangler.jsonc --env staging",
		"deploy:bedrock-provider:dev-miguel": "wrangler deploy -c workers/bedrock-provider/wrangler.jsonc --env dev-miguel",
		"deploy:bedrock-provider:dev-illiana": "wrangler deploy -c workers/bedrock-provider/wrangler.jsonc --env dev-illiana",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"test:desktop-agentos-renderer": "vitest run tests/desktop-agentos-app-streaming.test.tsx",
		"test:desktop-agentos-openrouter": "bun run desktop-agentos:install && vitest run --config vitest.desktop-agentos.config.ts",
		"test:all": "bun run test:run && bun run test:workers",
		"test:workers": "vitest run --config vitest.workers.config.ts",
		"test:workers:codex-web": "vitest run --config vitest.workers.config.ts workers/main/tests/web-codex-provider.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"dev:sandbox-host": "node scripts/dev-sandbox-host.mjs",
		"test:sandbox-host": "cd services/sandbox-host && CGO_ENABLED=0 go test ./...",
		"build:renderer": "vite build --config vite.renderer.config.ts",
		"deploy:go": "bash scripts/deploy-go-services.sh",
		"deploy:go:sandbox-host": "bash scripts/deploy-go-services.sh sandbox-host",
		"deploy:go:data-proxy": "bash scripts/deploy-go-services.sh data-proxy"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.71.2",
		"@cloudflare/vite-plugin": "^1.25.4",
		"@conform-to/react": "^1.15.1",
		"@conform-to/zod": "^1.15.1",
		"@modelcontextprotocol/sdk": "^1.25.2",
		"@monaco-editor/react": "^4.7.0",
		"@react-email/components": "^1.0.7",
		"@react-email/render": "^2.0.4",
		"@react-pdf/renderer": "^4.3.2",
		"@react-router/cloudflare": "^7.13.1",
		"@shikijs/rehype": "^3.20.0",
		"agents": "^0.6.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cookie": "^1.0.2",
		"hono": "^4.12.3",
		"hono-zod-openapi": "^1.1.1",
		"isbot": "^5.1.17",
		"lucide-react": "^0.562.0",
		"monaco-editor": "^0.55.1",
		"next-themes": "^0.4.6",
		"postal-mime": "^2.7.3",
		"radix-ui": "^1.4.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.1.1",
		"react-router": "^7.6.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"shiki": "^3.20.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"unified": "^11.0.5",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@cloudflare/puppeteer": "^1.0.6",
		"@cloudflare/vitest-pool-workers": "^0.12.16",
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.57.0",
		"@react-router/dev": "^7.6.1",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/cookie": "^1.0.0",
		"@types/node": "^20.19.27",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5.1.2",
		"bun-types": "^1.3.4",
		"electron": "^37.2.6",
		"electron-builder": "26.8.1",
		"eslint": "^9",
		"jsdom": "^27.3.0",
		"png-to-ico": "^3.0.1",
		"shadcn": "^3.6.2",
		"sharp": "^0.34.5",
		"tailwindcss": "^4",
		"tsx": "^4.20.6",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5",
		"vite": "8.0.0-beta.16",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4",
		"wrangler": "^4.68.0"
	},
	"overrides": {
		"vite": "$vite"
	}
}
