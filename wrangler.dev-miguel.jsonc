{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-app-dev-miguel",
	"main": "build/server/index.js",
	"no_bundle": true,
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"observability": { "enabled": true },
	"rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
	"routes": [
		{ "pattern": "dev-miguel.chiridion.ai/*", "zone_name": "chiridion.ai" }
	],
	"vars": {
		"R2_BUCKET_NAME": "chiridion-sandbox",
		"R2_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
		"R2_MOUNT_DIR": "/home/claude",
		"R2_PARENT_ACCESS_KEY_ID": "4f8fdc386b4ccb9f4a2bea3c77c8ad95",
		"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
		"CF_DISPATCH_NAMESPACE": "chiridion-platform-dev-miguel",
		"WORKER_BASE_URL": "https://dev-miguel.chiridion.ai",
		"PROXY_BASE_URL": "https://dev-miguel.chiridion.ai"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "build/client"
	},
	"images": { "binding": "IMAGES" },
	"browser": { "binding": "BROWSER" },
	"ai": { "binding": "AI", "remote": true },
	"r2_buckets": [
		{ "binding": "R2_BUCKET", "bucket_name": "chiridion-sandbox" }
	],
	"analytics_engine_datasets": [
		{ "binding": "ERROR_ANALYTICS", "dataset": "chiridion_errors_dev_miguel" }
	],
	"kv_namespaces": [
		{ "binding": "EMAIL_TO_USER", "id": "06c511f882d041ea89a98cb413f4b2f3" },
		{ "binding": "API_TOKENS", "id": "e894eb2caf1641ad8870da994b992fce" },
		{ "binding": "SESSIONS", "id": "a38773869d2e465fbf705c81fa2e01eb" }
	],
	"queues": {
		"producers": [
			{ "binding": "APP_SCREENSHOT_QUEUE", "queue": "chiridion-app-screenshots-dev-miguel" }
		],
		"consumers": [
			{ "queue": "chiridion-app-screenshots-dev-miguel" }
		]
	},
	"services": [
		{ "binding": "WORKER_SELF_REFERENCE", "service": "chiridion-app-dev-miguel" },
		{ "binding": "PROXY", "service": "chiridion-llm-proxy-dev-miguel" }
	],
	"containers": [
		{
			"name": "chiridion-app-dev-miguel-threadsandbox-dev-miguel",
			"class_name": "ThreadSandbox",
			"image": "./Dockerfile",
			"instance_type": { "vcpu": 1, "memory_mib": 4096, "disk_mb": 8000 },
			"max_instances": 5
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_THREAD", "class_name": "ChatThreadDO" },
			{ "name": "SANDBOX", "class_name": "ThreadSandbox" },
			{ "name": "USER", "class_name": "UserDO" },
			{ "name": "ORG", "class_name": "OrgDO" },
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
			{ "name": "MCP_OBJECT", "class_name": "ChiridionMcp" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatDurableObject"] },
		{ "tag": "v2", "deleted_classes": ["ChatDurableObject"] },
		{ "tag": "v3", "new_sqlite_classes": ["ChatThreadDO", "ChatIndexDO"] },
		{ "tag": "v4", "new_sqlite_classes": ["ThreadSandbox"] },
		{ "tag": "v5", "new_sqlite_classes": ["SessionDO", "UserDO", "OrgDO"] },
		{ "tag": "v6", "new_sqlite_classes": ["WorkspaceDO"] },
		{ "tag": "v7", "deleted_classes": ["SessionDO"] },
		{ "tag": "v8", "deleted_classes": ["ChatIndexDO"] },
		{ "tag": "v9", "new_sqlite_classes": ["ChiridionMcp"] }
	]
}
