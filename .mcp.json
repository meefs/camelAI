{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "camelai-admin-staging": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://staging.camelai.dev/api/admin/mcp",
        "--resource",
        "https://staging.camelai.dev/api/admin/mcp"
      ]
    }
  }
}
