{
	"name": "notebook-static",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"cf-typegen": "bun wrangler types",
		"postinstall": "bun run cf-typegen",
		"deploy": "bun run build && bun wrangler deploy --dispatch-namespace chiridion",
		"dev": "vite",
		"preview": "vite preview",
		"typecheck": "bun run cf-typegen && tsc --noEmit"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.2.5",
		"@fontsource-variable/inter": "^5.2.5",
		"@fontsource-variable/noto-sans": "^5.2.5",
		"@fontsource-variable/nunito-sans": "^5.2.5",
		"clsx": "^2.1.1",
		"lucide-react": "^0.562.0",
		"radix-ui": "^1.4.3",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.4.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^22",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"vite": "8.0.0-beta.11",
		"wrangler": "^4.16.0"
	}
}
