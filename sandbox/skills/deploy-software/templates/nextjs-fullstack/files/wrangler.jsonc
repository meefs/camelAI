{
  "name": "{{PROJECT_NAME}}",
  // Custom worker entry point - wraps OpenNext and exports Durable Objects
  "main": "workers/src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // To add Durable Objects, see the example in workers/src/durable-objects.example.ts
  // then uncomment and customize:
  //
  // "durable_objects": {
  //   "bindings": [
  //     { "name": "MY_DO", "class_name": "MyDurableObject" }
  //   ]
  // },
  // "migrations": [
  //   { "tag": "v1", "new_sqlite_classes": ["MyDurableObject"] }
  // ]
}
