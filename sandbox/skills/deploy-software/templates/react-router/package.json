{
	"name": "rr7-template",
	"private": true,
	"type": "module",
	"packageManager": "yarn@4.6.0",
	"overrides": {
		"wrangler": "*"
	},
	"resolutions": {
		"wrangler": "4.999.0"
	},
	"scripts": {
