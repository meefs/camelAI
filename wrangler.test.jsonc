{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-app-test",
	"main": "workers/main/src/index.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"OPENROUTER_API_KEY": "test-openrouter-key",
		"TOKEN_SIGNING_SECRET": "test-signing-secret-for-unit-tests-only"
	},
	"kv_namespaces": [
		{
			"binding": "EMAIL_TO_USER",
			"id": "test-email-to-user"
		},
		{
			"binding": "API_TOKENS",
			"id": "test-api-tokens"
		},
		{
			"binding": "SESSIONS",
			"id": "test-sessions"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "USER", "class_name": "UserDO" },
			{ "name": "ORG", "class_name": "OrgDO" },
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["UserDO", "OrgDO", "WorkspaceDO"] }
	]
}
