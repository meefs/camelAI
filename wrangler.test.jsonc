{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-app-test",
	"main": "workers/main/src/index.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [
		{
			"binding": "EMAIL_TO_USER",
			"id": "test-email-to-user"
		},
		{
			"binding": "API_TOKENS",
			"id": "test-api-tokens"
		}
	],
	"services": [
		{
			"binding": "DO_RPC",
			"service": "chiridion-app-test",
			"entrypoint": "DoRpcService"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_INDEX", "class_name": "ChatIndexDO" },
			{ "name": "SESSION", "class_name": "SessionDO" },
			{ "name": "USER", "class_name": "UserDO" },
			{ "name": "ORG", "class_name": "OrgDO" },
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatIndexDO", "SessionDO", "UserDO", "OrgDO", "WorkspaceDO"] }
	]
}
