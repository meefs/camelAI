{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chiridion-app-test",
	"main": "workers/main/src/index.ts",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"AI_VIRTUAL_MODEL": "dynamic/auto",
		"CF_ACCOUNT_ID": "85bbd288051330fb51ee1c86031a299b",
		"CF_GATEWAY_NAME": "chiridion",
		"TOKEN_SIGNING_SECRET": "test-signing-secret-for-unit-tests-only",
		"INTEGRATION_SECRET_KEY": "test-secret-key-for-integration-tests"
	},
	"kv_namespaces": [
		{
			"binding": "EMAIL_TO_USER",
			"id": "test-email-to-user"
		},
		{
			"binding": "APP_KV",
			"id": "test-api-tokens"
		},
		{
			"binding": "SESSIONS",
			"id": "test-sessions"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "USER", "class_name": "UserDO" },
			{ "name": "ORG", "class_name": "OrgDO" },
			{ "name": "ORG_SLUG", "class_name": "OrgSlugDO" },
			{ "name": "EMAIL_HANDLE", "class_name": "EmailHandleDO" },
			{ "name": "WORKSPACE", "class_name": "WorkspaceDO" },
			{ "name": "ADMIN_INDEX", "class_name": "AdminIndexDO" },
			{ "name": "WORKSPACE_CRON", "class_name": "WorkspaceCronDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["UserDO", "OrgDO", "OrgSlugDO", "WorkspaceDO", "EmailHandleDO"] },
		{ "tag": "v2", "new_sqlite_classes": ["AdminIndexDO"] },
		{ "tag": "v3", "new_sqlite_classes": ["OAuthStateDO"] },
		{ "tag": "v4", "new_sqlite_classes": ["WorkspaceCronDO"] },
		{ "tag": "v5", "deleted_classes": ["OAuthStateDO"] }
	]
}
