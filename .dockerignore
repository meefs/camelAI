# Ignore template install artifacts - bun install runs at container startup
sandbox/skills/developing-software/templates/*/node_modules
sandbox/skills/developing-software/templates/*/.bun
sandbox/skills/developing-software/templates/*/.pnp.cjs
sandbox/skills/developing-software/templates/*/.pnp.loader.mjs

# Ignore session-search node_modules (native modules must be compiled in container)
sandbox/session-search/node_modules

# Ignore local development artifacts
node_modules
.wrangler
.react-router
build
dist

# Ignore git and IDE files
.git
.gitignore
.vscode
.idea
*.swp
*.swo

# Ignore documentation (except skills)
*.md
!sandbox/skills/**/*.md

# Ignore source maps and build artifacts
*.map
*.tsbuildinfo

# Ignore env files
.env*
.dev.vars*
